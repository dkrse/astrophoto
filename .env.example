# Copy to .env and fill in:  cp .env.example .env && chmod 600 .env

# PostgreSQL connection (the database must exist; tables are created automatically)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/astrophoto

# Session signing key – long random string:
#   python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=change-me

# Data folder inside the container (mapped to a host path in docker-compose.yml)
DATA_DIR=/data

# Optional: separate test database for ./run-tests.sh
# (default: same server as DATABASE_URL, database "astrophoto_test" – dropped and recreated on every run)
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/astrophoto_test
